@page "/login"
@layout FrontBlazor_AppiGenericaCsharp.Components.Layout.EmptyLayout
@inject FrontBlazor_AppiGenericaCsharp.Services.AuthService auth
@inject NavigationManager nav
@rendermode InteractiveServer

<div class="min-vh-100 d-flex align-items-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-5">
                <div class="card shadow-lg border-0" style="border-radius: 15px; overflow: hidden;">
                    
                    <!-- HEADER DEL CARD -->
                    <div class="card-header bg-gradient p-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none;">
                        <div class="text-center text-white">
                            <div style="font-size: 48px; margin-bottom: 1rem;">
                                <i class="fas fa-lock"></i>
                            </div>
                            <h2 class="mb-2" style="font-weight: 600; font-size: 28px;">Bienvenido</h2>
                            <p style="opacity: 0.9; margin-bottom: 0;">Inicia sesión en tu cuenta</p>
                        </div>
                    </div>

                    <!-- BODY DEL CARD -->
                    <div class="card-body p-4">
                        
                        @if (!string.IsNullOrEmpty(error))
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="fas fa-exclamation-circle me-2"></i>
                                @error
                                <button type="button" class="btn-close" @onclick='() => error = ""'></button>
                            </div>
                        }

                        <form>
                            <!-- EMAIL -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-dark">
                                    <i class="fas fa-envelope text-primary me-2"></i>Email o Usuario
                                </label>
                                <input type="email" 
                                       class="form-control form-control-lg" 
                                       placeholder="tu@email.com"
                                       @bind="email"
                                       disabled="@cargando"
                                       style="border: 2px solid #e0e0e0; border-radius: 8px;" />
                            </div>

                            <!-- CONTRASEÑA -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="form-label fw-semibold text-dark mb-0">
                                        <i class="fas fa-key text-primary me-2"></i>Contraseña
                                    </label>
                                    <a href="/recuperar-contrasena" class="small text-primary text-decoration-none">
                                        ¿Olvidaste tu contraseña?
                                    </a>
                                </div>
                                <input type="password" 
                                       class="form-control form-control-lg" 
                                       placeholder="••••••••"
                                       @bind="contrasena"
                                       @onkeypress="OnKeyPress"
                                       disabled="@cargando"
                                       style="border: 2px solid #e0e0e0; border-radius: 8px;" />
                            </div>

                            <!-- BOTÓN LOGIN -->
                            <button type="button" 
                                    class="btn btn-lg w-100 fw-semibold" 
                                    style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; border-radius: 8px; padding: 12px;"
                                    @onclick="DoLogin"
                                    disabled="@(string.IsNullOrEmpty(email) || string.IsNullOrEmpty(contrasena) || cargando)">
                                @if (cargando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Iniciando sesión...</span>
                                }
                                else
                                {
                                    <span><i class="fas fa-sign-in-alt me-2"></i>Iniciar Sesión</span>
                                }
                            </button>

                            <!-- LINK REGISTRO -->
                            <div class="text-center mt-4">
                                <p class="text-muted mb-0">
                                    ¿No tienes cuenta?
                                    <a href="/registro" class="text-decoration-none fw-semibold" style="color: #667eea;">
                                        Crea una ahora
                                    </a>
                                </p>
                            </div>
                        </form>
                    </div>

                    <!-- FOOTER DEL CARD -->
                    <div class="card-footer bg-light p-3 text-center" style="border-top: 1px solid #f0f0f0;">
                        <small class="text-muted">
                            <i class="fas fa-shield-alt me-1"></i>Tu información está protegida con encriptación SSL
                        </small>
                    </div>
                </div>

                <!-- INFORMACIÓN ADICIONAL -->
                <div class="row mt-5 text-white text-center">
                    <div class="col-md-4 mb-3">
                        <div style="font-size: 28px; margin-bottom: 0.5rem;">
                            <i class="fas fa-bolt"></i>
                        </div>
                        <strong>Rápido</strong>
                        <p style="opacity: 0.8; font-size: 0.9rem; margin-top: 0.5rem;">Acceso inmediato</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div style="font-size: 28px; margin-bottom: 0.5rem;">
                            <i class="fas fa-lock"></i>
                        </div>
                        <strong>Seguro</strong>
                        <p style="opacity: 0.8; font-size: 0.9rem; margin-top: 0.5rem;">Encriptación avanzada</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div style="font-size: 28px; margin-bottom: 0.5rem;">
                            <i class="fas fa-mobile-alt"></i>
                        </div>
                        <strong>Responsive</strong>
                        <p style="opacity: 0.8; font-size: 0.9rem; margin-top: 0.5rem;">En cualquier dispositivo</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    string email = "", contrasena = "", error = "";
    bool cargando;

    async Task DoLogin()
    {
        error = "";
        cargando = true;
        var (ok, msg) = await auth.Login(email, contrasena);
        cargando = false;
        if (ok)
        {
            // Si recuperó contraseña, forzar cambio
            if (auth.DebeCambiarContrasena || auth.DebeForcarCambio(email))
            {
                auth.DebeCambiarContrasena = true;
                nav.NavigateTo("/cambiar-contrasena", forceLoad: false);
            }
            else
                nav.NavigateTo("/", forceLoad: false);
        }
        else error = msg;
    }

    async Task OnKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoLogin();
    }
}